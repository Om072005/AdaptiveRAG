{
  "name": "adaptiverag-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/design-check.mjs --data && tsc -b && vite build",
    "lint": "oxlint",
    "check": "node scripts/design-check.mjs && oxlint --deny-warnings && npm run -s unit && npm run -s build",
    "preview": "vite preview",
    "design": "node scripts/design-check.mjs",
    "smoke": "playwright test",
    "unit": "node --experimental-strip-types --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.1"
  }
}
