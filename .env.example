# Copy to .env and fill with YOUR values. Never commit .env.
DATABASE_URL=            # Neon pooled connection string of your own dev branch
DATABASE_URL_DIRECT=     # Neon direct connection string (migrations only)
GEMINI_API_KEY=          # optional: only the Gemini provider in config/models.toml uses it; every served model is local (D21)
ALLOW_TEST=0             # 1 only for the pinned test runs on D13

# live mode only (stretch)
LIVE_DAILY_BUDGET_USD=0.25
LIVE_RATE_LIMIT_PER_10MIN=10
IP_HASH_SALT=

# web/.env.local (build time, read by Vite)
VITE_LIVE_API_URL=       # empty = replay only (the default and the production setting)
VITE_ALLOW_SAMPLE=0      # 1 only locally or on previews
